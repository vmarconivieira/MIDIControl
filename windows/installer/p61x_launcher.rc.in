#include <windows.h>

1 ICON "@ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VER_COMMA@
 PRODUCTVERSION @VER_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "P61x Console\0"
            VALUE "FileDescription", "P61x Console Standalone Synth & Stage Controller\0"
            VALUE "FileVersion", "@VERSION_NAME@\0"
            VALUE "InternalName", "P61x Console\0"
            VALUE "OriginalFilename", "P61x Console.exe\0"
            VALUE "ProductName", "P61x Console\0"
            VALUE "ProductVersion", "@VERSION_NAME@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
